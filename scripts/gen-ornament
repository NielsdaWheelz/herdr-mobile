#!/usr/bin/env python3
"""Deterministically generate the frozen Niðavellir ornament geometry.

Owned by docs/ornament-pipeline.md; the family rules are design-language.md
§7 (fret construction) and §8 (the valknut, the launcher mark), and the mark's
own geometry is frozen by docs/launcher-mark.md. Generated geometry depends only
on the constants below: no clock, randomness, or external inputs.
`scripts/gen-ornament --check` generates once and
byte-compares the result against the checked-in files, so drift between this
generator and the committed output fails the static gate.

Two ornaments ship here, plus the launcher icon:
  * Fret cell: one chevron unit for the Forge title band (monoline, 45° turns).
  * Valknut: three interlocked equilateral triangles (tricursal, Borromean
    topology), same baked-gap technique at all six crossings.
  * Launcher mark: a cut-corner H gate for herdr, authored as one polygon.

Fret and valknut geometry is emitted as `OrnamentSegment` unit-box constants in
Ornament.kt; the launcher mark stays generator-internal and is emitted as the
whole adaptive-icon resource set.
"""

from __future__ import annotations

import argparse
import math
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ORNAMENT_KT = "android/app/src/main/java/dev/niels/herdr/mobile/Ornament.kt"
ICON_BACKGROUND_XML = "android/app/src/main/res/drawable/ic_launcher_background.xml"
ICON_FOREGROUND_XML = "android/app/src/main/res/drawable/ic_launcher_foreground.xml"
ICON_MONOCHROME_XML = "android/app/src/main/res/drawable/ic_launcher_monochrome.xml"
ICON_DESCRIPTOR_XML = "android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml"

# Android's documented adaptive-icon canvas.
_ICON_VIEWPORT = 108.0

# The width of the break cut at every valknut crossing, in units of the crossed
# edge's own length. Not a taste value: below 0.36 a crossing whose two cuts
# nearly meet leaves a stub of surviving edge between them, and that stub is
# shorter than the mark's own stroke is wide, so it renders as a speck rather
# than a strand. 0.36 is the first width that consumes every such stub — the
# segment count drops from 15 to 12 and the shortest surviving segment rises
# from 0.005 to 0.084 of the unit box. Widening further only eats the
# triangles. OrnamentTest pins both invariants (design-language.md §8).
_VALKNUT_GAP = 0.36


def _fmt_f(value: float) -> str:
    """A Kotlin Float literal for `value`, minimal and deterministic."""
    rounded = round(value, 6) + 0.0  # +0.0 folds -0.0 to 0.0
    text = f"{rounded:.6f}".rstrip("0").rstrip(".")
    return f"{text or '0'}f"


def _fmt_n(value: float) -> str:
    """A VectorDrawable pathData number for `value`."""
    rounded = round(value, 3) + 0.0
    text = f"{rounded:.3f}".rstrip("0").rstrip(".")
    return text or "0"


# --- Fret cell ---------------------------------------------------------


def _fret_cell() -> list[tuple[float, float, float, float]]:
    """One chevron unit in a 1:1 unit box: a "V" from (0,1) down to the apex
    at (0.5,0) and back up to (1,1). Both ends sit at y=1, so placing whole
    copies side by side (x -> x+1) continues the zigzag with no seam."""
    return [
        (0.0, 1.0, 0.5, 0.0),
        (0.5, 0.0, 1.0, 1.0),
    ]


# --- Weave helper (valknut baked gaps) ----------------------------------


def _split_with_gaps(
    p0: tuple[float, float],
    p1: tuple[float, float],
    cut_centers: list[float],
    gap: float,
) -> list[tuple[float, float, float, float]]:
    """Split the segment p0->p1 (parametrized t in [0,1]) around each center
    in `cut_centers`, removing a `gap`-wide window at every center. Overlapping
    windows merge. Returns the surviving pieces as absolute-coordinate
    segments; an empty `cut_centers` returns the segment whole."""
    windows = sorted((c - gap / 2, c + gap / 2) for c in cut_centers)
    merged: list[list[float]] = []
    for lo, hi in windows:
        if merged and lo <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], hi)
        else:
            merged.append([lo, hi])
    cuts = sorted({0.0, 1.0} | {max(0.0, min(1.0, v)) for w in merged for v in w})

    def point_at(t: float) -> tuple[float, float]:
        return (p0[0] + (p1[0] - p0[0]) * t, p0[1] + (p1[1] - p0[1]) * t)

    pieces = []
    for a, b in zip(cuts, cuts[1:]):
        mid = (a + b) / 2
        if any(lo <= mid <= hi for lo, hi in merged):
            continue
        if b - a < 1e-9:
            continue
        pieces.append(point_at(a) + point_at(b))
    return pieces


# --- Valknut --------------------------------------------------------------


def _rotate(p: tuple[float, float], degrees: float) -> tuple[float, float]:
    a = math.radians(degrees)
    x, y = p
    return (x * math.cos(a) - y * math.sin(a), x * math.sin(a) + y * math.cos(a))


def _triangle(centroid: tuple[float, float], radius: float, phi0: float) -> list[tuple[float, float]]:
    cx, cy = centroid
    return [
        (cx + radius * math.cos(math.radians(phi0 + 120 * k)), cy + radius * math.sin(math.radians(phi0 + 120 * k)))
        for k in range(3)
    ]


def _seg_intersect_t(p1, p2, p3, p4) -> tuple[float, float] | None:
    (x1, y1), (x2, y2), (x3, y3), (x4, y4) = p1, p2, p3, p4
    d = (x1 - x2) * (y3 - y4) - (y1 - y2) * (x3 - x4)
    if abs(d) < 1e-9:
        return None
    t = ((x1 - x3) * (y3 - y4) - (y1 - y3) * (x3 - x4)) / d
    u = ((x1 - x3) * (y1 - y2) - (y1 - y3) * (x1 - x2)) / d
    if 1e-9 < t < 1 - 1e-9 and 1e-9 < u < 1 - 1e-9:
        return (t, u)
    return None


def _valknut(gap: float = _VALKNUT_GAP) -> list[tuple[float, float, float, float]]:
    """The tricursal valknut (design-language.md §8): three congruent
    equilateral triangles, each the previous rotated 120° about the shared
    center, with each triangle's own centroid itself offset from that center
    — the offset is what keeps the three from simply coinciding, giving the
    interlocked Borromean silhouette. Straight lines only. The six crossings
    are ordered by angle around the center; the over triangle alternates
    strictly walking that ring, and the losing triangle's edge is split with
    a gap at that crossing (`_split_with_gaps`), baking the weave into the
    data with no runtime over/under logic. `gap` defaults to `_VALKNUT_GAP`;
    the stroke that draws these segments is a fraction of the mark's own size,
    so a break stays the same share of the mark at every rendered size."""
    offset, radius, phi0, centroid_angle = 0.6, 1.0, 90.0, 135.0
    base_centroid = (offset * math.cos(math.radians(centroid_angle)), offset * math.sin(math.radians(centroid_angle)))
    base = _triangle(base_centroid, radius, phi0)
    triangles = [base, [_rotate(p, 120) for p in base], [_rotate(p, 240) for p in base]]
    edges = [[(t[i], t[(i + 1) % 3]) for i in range(3)] for t in triangles]

    crossings = []
    for a, b in ((0, 1), (1, 2), (0, 2)):
        for ea_idx, (pa0, pa1) in enumerate(edges[a]):
            for eb_idx, (pb0, pb1) in enumerate(edges[b]):
                hit = _seg_intersect_t(pa0, pa1, pb0, pb1)
                if hit is None:
                    continue
                t_a, t_b = hit
                x = pa0[0] + t_a * (pa1[0] - pa0[0])
                y = pa0[1] + t_a * (pa1[1] - pa0[1])
                crossings.append(
                    {"tri_a": a, "edge_a": ea_idx, "t_a": t_a, "tri_b": b, "edge_b": eb_idx, "t_b": t_b, "x": x, "y": y}
                )
    crossings.sort(key=lambda c: math.atan2(c["y"], c["x"]))
    for i, c in enumerate(crossings):
        c["over"] = c["tri_a"] if i % 2 == 0 else c["tri_b"]

    all_points = [p for t in triangles for p in t]
    half_span = max(max(abs(p[0]) for p in all_points), max(abs(p[1]) for p in all_points)) * 1.08

    def normalize(p: tuple[float, float]) -> tuple[float, float]:
        return (0.5 + p[0] / (2 * half_span), 0.5 - p[1] / (2 * half_span))

    segments = []
    for tri_idx in range(3):
        for edge_idx, (p0, p1) in enumerate(edges[tri_idx]):
            cut_centers = []
            for c in crossings:
                if c["over"] == tri_idx:
                    continue
                if c["tri_a"] == tri_idx and c["edge_a"] == edge_idx:
                    cut_centers.append(c["t_a"])
                elif c["tri_b"] == tri_idx and c["edge_b"] == edge_idx:
                    cut_centers.append(c["t_b"])
            for seg in _split_with_gaps(p0, p1, cut_centers, gap):
                segments.append((*normalize(seg[0:2]), *normalize(seg[2:4])))
    return segments


# --- Launcher mark ----------------------------------------------------------
# The product mark is a gate-shaped H. One polygon owns its silhouette in both
# layers; the foreground colours its bridge bronze. This leaves the themed
# icon legible when Android applies one flat tint to the monochrome drawable.

ICON_ENVELOPE = 34.0  # Android's circular mask clips at 36 units.
_GOLD, _BRONZE = "#D6A85F", "#CD7F32"
_INK, _DEEP_SURFACE = "#0C0D0F", "#15171A"
_MARK_CENTRE = _ICON_VIEWPORT / 2

# Cut corners echo the app's cards and seals. The bridge joins both ten-unit
# stems, so the monochrome mark has no colour-dependent seams or thin gaps.
_GATE = [
    (37.0, 30.0), (42.0, 35.0), (42.0, 49.0), (66.0, 49.0),
    (66.0, 35.0), (71.0, 30.0), (76.0, 35.0), (76.0, 73.0),
    (71.0, 78.0), (66.0, 73.0), (66.0, 59.0), (42.0, 59.0),
    (42.0, 73.0), (37.0, 78.0), (32.0, 73.0), (32.0, 35.0),
]
_BRIDGE = [(42.0, 49.0), (66.0, 49.0), (66.0, 59.0), (42.0, 59.0)]


def _require_within_envelope(polygons: list[list[tuple[float, float]]]) -> None:
    for ring in polygons:
        for x, y in ring:
            radius = math.hypot(x - _MARK_CENTRE, y - _MARK_CENTRE)
            if radius > ICON_ENVELOPE:
                raise ValueError(
                    f"({_fmt_n(x)},{_fmt_n(y)}) sits at r={radius:.3f}, "
                    f"outside the {ICON_ENVELOPE:.0f}-unit mask envelope"
                )


def _mark_layers() -> tuple[list, list, list]:
    background = [
        ([[(0.0, 0.0), (_ICON_VIEWPORT, 0.0), (_ICON_VIEWPORT, _ICON_VIEWPORT), (0.0, _ICON_VIEWPORT)]], _INK),
        ([[(0.0, 0.0), (_ICON_VIEWPORT, 0.0), (0.0, _ICON_VIEWPORT)]], _DEEP_SURFACE),
    ]
    foreground = [([_GATE], _GOLD), ([_BRIDGE], _BRONZE)]
    monochrome = [([_GATE], _GOLD)]
    return background, foreground, monochrome


# --- Kotlin + XML rendering -------------------------------------------------

_XML_HEADER = (
    '<?xml version="1.0" encoding="utf-8"?>\n'
    "<!-- GENERATED BY scripts/gen-ornament — DO NOT EDIT -->\n"
)


def _kotlin_segments(name: str, segments: list[tuple[float, float, float, float]]) -> str:
    lines = ",\n".join(
        f"    OrnamentSegment({_fmt_f(x1)}, {_fmt_f(y1)}, {_fmt_f(x2)}, {_fmt_f(y2)})" for x1, y1, x2, y2 in segments
    )
    return f"internal val {name}: List<OrnamentSegment> = listOf(\n{lines},\n)\n"


def _path_data(polygons: list[list[tuple[float, float]]]) -> str:
    """M/L/Z path data, one closed ring per polygon."""
    return "".join(
        f"M{_fmt_n(ring[0][0])},{_fmt_n(ring[0][1])}"
        + "".join(f"L{_fmt_n(x)},{_fmt_n(y)}" for x, y in ring[1:])
        + "Z"
        for ring in polygons
    )


def _vector(paths: list[tuple[str, str]], comment: str) -> bytes:
    """One VectorDrawable on the adaptive-icon canvas, one <path> per
    (colour, pathData) pair."""
    body = "\n".join(
        f"    <path\n"
        f'        android:fillColor="{colour}"\n'
        f'        android:pathData="{data}" />'
        for colour, data in paths
    )
    return (
        _XML_HEADER + f"<!-- {comment} -->\n"
        '<vector xmlns:android="http://schemas.android.com/apk/res/android"\n'
        f'    android:width="{_fmt_n(_ICON_VIEWPORT)}dp"\n'
        f'    android:height="{_fmt_n(_ICON_VIEWPORT)}dp"\n'
        f'    android:viewportWidth="{_fmt_n(_ICON_VIEWPORT)}"\n'
        f'    android:viewportHeight="{_fmt_n(_ICON_VIEWPORT)}">\n'
        f"{body}\n"
        "</vector>\n"
    ).encode("utf-8")


def build_outputs() -> dict[str, bytes]:
    """The full generated-output set, keyed by repo-relative path."""
    kotlin = "".join(
        [
            "package dev.niels.herdr.mobile\n",
            "\n",
            "// GENERATED BY scripts/gen-ornament — DO NOT EDIT\n",
            "//\n",
            "// Frozen ornament geometry (design-language.md §7 §8, ornament-pipeline.md).\n",
            "// Every List<OrnamentSegment> below is monoline stroke data in a unit box;\n",
            "// topology is computed on-device — the app only draws these constants.\n",
            "\n",
            "internal data class OrnamentSegment(val x1: Float, val y1: Float, val x2: Float, val y2: Float)\n",
            "\n",
            "// One chevron unit (design-language.md §7): 45° turns only, unit box aspect\n",
            "// 1:1. Tiles horizontally with no seam — every copy starts and ends at y=1.\n",
            _kotlin_segments("FretCell", _fret_cell()),
            "\n",
            "// The tricursal valknut (design-language.md §8): three interlocked\n",
            "// equilateral triangles, Borromean topology, straight lines only, unit box\n",
            "// aspect 1:1. All six over/under crossings are baked as gaps, sized so\n",
            "// the weave survives every rendered size against a proportional stroke.\n",
            _kotlin_segments("Valknut", _valknut()),
        ]
    )

    background, foreground, monochrome = _mark_layers()
    # The background is a full-canvas plane the launcher's mask is meant to
    # clip, so only the mark itself is measured against the envelope.
    _require_within_envelope([ring for layer in (foreground, monochrome) for rings, _ in layer for ring in rings])
    descriptor = (
        _XML_HEADER + "<!-- The launcher identity is the herdr gate (docs/launcher-mark.md).\n"
        "     monochrome is its own drawable with the same solid gate silhouette. -->\n"
        '<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">\n'
        '    <background android:drawable="@drawable/ic_launcher_background" />\n'
        '    <foreground android:drawable="@drawable/ic_launcher_foreground" />\n'
        '    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />\n'
        "</adaptive-icon>\n"
    )

    return {
        ORNAMENT_KT: kotlin.encode("utf-8"),
        ICON_BACKGROUND_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in background],
            "Ink with a DeepSurface diagonal facet.",
        ),
        ICON_FOREGROUND_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in foreground],
            "The herdr gate: a Gold H with a Bronze bridge.",
        ),
        ICON_MONOCHROME_XML: _vector(
            [(colour, _path_data(rings)) for rings, colour in monochrome],
            "The gate silhouette survives one flat launcher tint.",
        ),
        ICON_DESCRIPTOR_XML: descriptor.encode("utf-8"),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Check generated files without writing them.")
    parser.add_argument(
        "--out-root",
        type=Path,
        default=ROOT,
        help="Write or check generated files under this root (default: repo root).",
    )
    args = parser.parse_args()
    try:
        outputs = build_outputs()
        for relative, content in outputs.items():
            destination = args.out_root / relative
            if args.check:
                if not destination.is_file() or destination.read_bytes() != content:
                    raise ValueError(f"generated file is missing or stale: {relative}")
            else:
                destination.parent.mkdir(parents=True, exist_ok=True)
                destination.write_bytes(content)
                print(f"wrote {relative} ({len(content)} bytes)")
    except (OSError, ValueError) as error:
        print(f"ornament {'check' if args.check else 'generation'} failed: {error}", file=sys.stderr)
        return 1
    if args.check:
        print(f"ornament check passed: {len(outputs)} generated files")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
